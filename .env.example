# Kaggle API — required for R9 download script
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face — required to pull gated Llama weights for vllm service
# Accept license first: https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct
HUGGING_FACE_HUB_TOKEN=

# MinIO — matches docker-compose.yml defaults if unset
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres — matches docker-compose.yml defaults if unset
POSTGRES_USER=contextlens
POSTGRES_PASSWORD=contextlens
